# Copy this file to .env and fill in your API keys.

# Unusual Whales — options flow, dark pool, sector tide.
# Get one at https://unusualwhales.com/ (API access requires a paid plan).
UW_TOKEN=your_unusual_whales_api_token_here

# Massive — daily bars / live snapshots for the single-name swing scanner
# (swing_scan.py). Not needed if you run with --data-dir using files exported
# by the Massive MCP tools.
MASSIVE_API_KEY=your_massive_api_key_here
